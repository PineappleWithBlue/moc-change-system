# MOC 产品工程变更管理系统 - 环境变量配置
# 
# 1. 留空表示使用系统内置的 Next.js API 服务（数据持久化在本地 .data/moc-database.json 文件中，适合本地测试环境无依赖运行）
# 2. 当有真实后台服务时，配置为后端实际地址（例如：http://localhost:8080 或 https://api-test.corp.example.com）
NEXT_PUBLIC_API_BASE_URL=

# 预留 Azure Entra ID SSO 配置项 (未来正式环境启用)
# NEXT_PUBLIC_AZURE_CLIENT_ID=
# NEXT_PUBLIC_AZURE_TENANT_ID=
# NEXT_PUBLIC_AZURE_REDIRECT_URI=http://localhost:3000
